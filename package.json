{
  "name": "tranccompr",
  "version": "1.0.0",
  "description": "Chat application with React frontend",
  "main": "dist/server.js",
  "scripts": {
    "build": "npm run build:server && npm run build:frontend",
    "build:server": "node_modules/.bin/tsc --project tsconfig.json",
    "build:frontend": "react-scripts build",
    "start": "node dist/server.js",
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "ts-node server.ts",
    "dev:client": "react-scripts start",
    "client": "react-scripts start"
  },
  "dependencies": {
    "@fastify/cors": "^11.1.0",
    "@fastify/static": "^8.3.0",
    "better-sqlite3": "^9.2.2",
    "express": "^4.18.2",
    "fastify": "^5.6.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "socket.io": "^4.7.0",
    "socket.io-client": "^4.7.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.8",
    "@types/node": "^24.9.1",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "concurrently": "^8.2.0",
    "react-scripts": "5.0.1",
    "ts-node": "^10.9.0",
    "typescript": "^5.9.3"
  },
  "keywords": [
    "chat",
    "react",
    "socket.io"
  ],
  "license": "ISC",
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
